rules_version = '2';
// Meu Ponto — cada usuário só enxerga e altera os PRÓPRIOS dados.
// Tudo o que não está liberado abaixo é negado (inclusive listar usuários).
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function dono(uid) { return logado() && request.auth.uid == uid; }
    function hora(v) { return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }
    function horaOpc(d, k) { return !(k in d) || hora(d[k]); }

    match /usuarios/{uid} {
      // Perfil: só ajustes padrão. Sem e-mail, nome ou outros dados pessoais.
      allow get, delete: if dono(uid);
      allow create, update: if dono(uid)
        && request.resource.data.keys().hasOnly(['jornada', 'intervalo', 'modo', 'atualizado'])
        && horaOpc(request.resource.data, 'jornada')
        && horaOpc(request.resource.data, 'intervalo')
        && (!('modo' in request.resource.data) || request.resource.data.modo in ['S', 'C'])
        && request.resource.data.atualizado == request.time;

      match /dias/{dia} {
        allow get, delete: if dono(uid);
        // Listagem limitada: evita leitura em massa mesmo pela própria conta.
        allow list: if dono(uid) && request.query.limit <= 400;
        allow create, update: if dono(uid)
          && dia.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && request.resource.data.keys().hasOnly(['entrada', 'saiAlm', 'volAlm', 'saida', 'jornada', 'intervalo', 'atualizado'])
          && horaOpc(request.resource.data, 'entrada')
          && horaOpc(request.resource.data, 'saiAlm')
          && horaOpc(request.resource.data, 'volAlm')
          && horaOpc(request.resource.data, 'saida')
          && horaOpc(request.resource.data, 'jornada')
          && horaOpc(request.resource.data, 'intervalo')
          && request.resource.data.atualizado == request.time;
      }
    }

    // Qualquer outro caminho: negado.
    match /{caminho=**} { allow read, write: if false; }
  }
}
